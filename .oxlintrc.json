{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "typescript/no-explicit-any": "off",
    "typescript/no-this-alias": "off",
    "no-cond-assign": "off"
  },
  "ignorePatterns": [
    "coverage",
    "dist",
    "dist/**",
    "node_modules",
    "reference/**",
    "src/vendor/**",
    "test/dom/fixtures"
  ]
}
