# Copy to .env.local (gitignored) and fill in. Get api_id / api_hash at https://my.telegram.org/apps.
# Never commit real credentials.
TG_TELEGRAM_API_ID=
TG_TELEGRAM_API_HASH=

# Optional overrides (the defaults match telegram-tt)
# APP_ENV=development            # development | staging | production | test
# BASE_URL=https://web.telegram.org/a/
# APP_TITLE=
# APP_NAME=
# TEST_SESSION=
# APP_MOCKED_CLIENT=1            # swap GramJS TelegramClient for the in-repo MockClient
# HTTPS_CERT_PATH=
# HTTPS_KEY_PATH=

# Dev smoke test of the ported GramJS API worker: `pnpm dev`, then open http://localhost:1234/?api
# (logs worker start and API updates to the console; without credentials it only logs this hint).
