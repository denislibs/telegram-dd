{
  "name": "tg-frameact",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "cross-env APP_ENV=development vite --mode development",
    "dev:mocked": "cross-env APP_ENV=test APP_MOCKED_CLIENT=1 vite --mode development --port 1235",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:production": "cross-env APP_ENV=production vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.script.json --noEmit",
    "test": "cross-env APP_ENV=test vitest run --silent=true",
    "gramjs:tl": "tsx ./src/lib/gramjs/tl/generateModules.ts",
    "tl:rehash": "node ./dev/tlHash.js",
    "lint": "oxlint --type-aware --ignore-pattern 'src/vendor/**' --ignore-pattern 'reference/**' .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm gates:diff && pnpm gates:tests && pnpm gates:licenses && pnpm build && pnpm gates:size",
    "gates": "tsx scripts/gates/run.ts",
    "gates:diff": "tsx scripts/gates/diff.ts",
    "gates:upstream": "tsx scripts/gates/upstream.ts",
    "gates:tests": "tsx scripts/gates/tests.ts",
    "gates:size": "tsx scripts/gates/size.ts",
    "gates:licenses": "tsx scripts/gates/licenses.ts",
    "gates:reference": "tsx scripts/gates/setup-reference.ts",
    "bench:store": "tsx scripts/bench/store.ts",
    "framework:update": "git submodule update --remote src/vendor/frameact",
    "test:e2e": "playwright test --project=e2e",
    "test:a11y": "playwright test --project=a11y",
    "test:perf": "playwright test -c playwright.perf.config.ts",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:browser": "pnpm test:e2e && pnpm test:a11y && pnpm test:perf",
    "visual:tt": "node scripts/visual/tt-run.mjs serve",
    "playwright:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@cryptography/aes": "^0.1.1",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-notification": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-code": "^3.31.3",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-details": "^3.31.3",
    "@tiptap/extension-heading": "^3.31.3",
    "@tiptap/extension-horizontal-rule": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-strike": "^3.31.3",
    "@tiptap/extension-subscript": "^3.31.3",
    "@tiptap/extension-superscript": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "async-mutex": "^0.5.0",
    "colorjs.io": "^0.7.1",
    "emoji-data-ios": "github:korenskoy/emoji-data-ios#73efe6b65daa36dd6ec188d71ef4f06f78634c5f",
    "fflate": "^0.8.3",
    "frameact": "workspace:*",
    "idb-keyval": "^6.3.0",
    "lovely-chart": "^2.0.6",
    "lowlight": "^3.3.0",
    "music-metadata": "^11.16.0",
    "opus-recorder": "github:Ajaxy/opus-recorder#116830a94120baad5ac60ac060c2ecd032b6107b",
    "qr-code-styling": "^1.9.2",
    "temml": "^0.13.5",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/dom-chromium-ai": "^0.0.17",
    "@types/dom-view-transitions": "^1.0.6",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "eslint-plugin-no-null": "^1.0.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.28",
    "postcss-load-config": "^6.0.1",
    "postcss-smooth-corners": "^0.1.1",
    "prettier": "^3.9.10",
    "sass": "^1.105.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "user-agent-data-types": "^0.4.3",
    "vite": "^8.3.4",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.0.1"
  }
}
